<div class="card">
  <div class="card-body p-5 bg-light">
    <h1 class="mb-4"><%= it.t('views.session.new.signIn') %></h1>
    <form action="<%= it.route('createSession') %>" method="post">
      <%~ include('../mixins/input', { propertyName: 'email', type: 'text', label: it.t('views.users.email'), entity: {}, errors: {} }) %>
      <%~ include('../mixins/input', { propertyName: 'password', type: 'password', label: it.t('views.users.password'), entity: {}, errors: {} }) %>
      <button type="submit" class="btn btn-primary"><%= it.t('views.session.new.submit') %></button>
    </form>
  </div>
</div>
