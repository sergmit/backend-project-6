<div class="card">
  <div class="card-body p-5 bg-light">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="mb-0"><%= it.t('views.statuses.index.title') %></h1>
      <a class="btn btn-primary" href="<%= it.route('newStatus') %>"><%= it.t('views.statuses.index.create') %></a>
    </div>
    <% if (it.statuses.length === 0) { %>
      <p class="mb-0"><%= it.t('views.statuses.index.empty') %></p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
          <thead>
            <tr>
              <th scope="col"><%= it.t('views.statuses.id') %></th>
              <th scope="col"><%= it.t('views.statuses.name') %></th>
              <th scope="col"><%= it.t('views.statuses.createdAt') %></th>
              <th scope="col"><%= it.t('views.statuses.index.actions') %></th>
            </tr>
          </thead>
          <tbody>
            <% it.statuses.forEach((status) => { %>
              <tr>
                <td><%= status.id %></td>
                <td><%= status.name %></td>
                <td><%= it.formatDate(status.createdAt) %></td>
                <td>
                  <a class="btn btn-sm btn-outline-secondary" href="<%= it.route('editStatus', { id: status.id }) %>"><%= it.t('views.statuses.index.edit') %></a>
                  <form action="<%= it.route('deleteStatus', { id: status.id }) %>" method="post" class="d-inline">
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="btn btn-sm btn-danger"><%= it.t('views.statuses.index.delete') %></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
