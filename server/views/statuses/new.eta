<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card">
          <div class="card-body p-5 bg-light">
            <h1 class="mb-4"><%= it.t('views.statuses.new.title') %></h1>
            <form action="<%= it.route('createStatus') %>" method="post">
              <%~ include('../mixins/input', { propertyName: 'name', type: 'text', label: it.t('views.statuses.name'), entity: it.entity, errors: it.errors }) %>
              <button type="submit" class="btn btn-primary"><%= it.t('views.statuses.new.submit') %></button>
            </form>
          </div>
        </div>
    </div>
</div>
