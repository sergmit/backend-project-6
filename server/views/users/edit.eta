<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card">
          <div class="card-body p-5 bg-light">
            <h1 class="mb-4"><%= it.t('views.users.edit.title') %></h1>
            <form action="<%= it.route('updateUser', { id: it.entity.id }) %>" method="post">
              <input type="hidden" name="_method" value="PATCH">
              <%~ include('../mixins/input', { propertyName: 'email', type: 'text', label: it.t('views.users.email'), entity: it.entity, errors: it.errors }) %>
              <%~ include('../mixins/input', { propertyName: 'firstName', type: 'text', label: it.t('views.users.firstName'), entity: it.entity, errors: it.errors }) %>
              <%~ include('../mixins/input', { propertyName: 'lastName', type: 'text', label: it.t('views.users.lastName'), entity: it.entity, errors: it.errors }) %>
              <button type="submit" class="btn btn-primary"><%= it.t('views.users.edit.submit') %></button>
            </form>
          </div>
        </div>
    </div>
</div>
