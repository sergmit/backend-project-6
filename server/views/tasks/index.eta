<div class="row">
  <div class="col-12">
    <% if (it.tasks.length === 0) { %>
      <div class="alert alert-info">
        <%= it.t('views.tasks.index.empty') %>
      </div>
    <% } else { %>
      <div class="row">
        <% it.tasks.forEach((task) => { %>
          <div class="col-md-6 mb-3">
            <div class="card">
              <div class="card-body">
                <h5 class="card-title">
                  <a href="<%= it.route('showTask', { id: task.id }) %>" class="text-decoration-none"><%= task.name %></a>
                </h5>
                <p class="card-text"><%= task.description || 'No description' %></p>
                <% if (task.taskLabels.length > 0) { %>
                  <div class="mb-2">
                    <% task.taskLabels.forEach(({ label }) => { %>
                      <span class="badge bg-secondary"><%= label.name %></span>
                    <% }); %>
                  </div>
                <% } %>
                <div class="d-flex justify-content-between align-items-center">
                  <span class="badge bg-secondary"><%= task.status.name %></span>
                  <small class="text-muted">by <%= task.creator.firstName %> <%= task.creator.lastName %></small>
                </div>
                <% if (it.isAuthenticated() && it.currentUser?.id === task.creatorId) { %>
                  <div class="mt-2">
                    <a href="<%= it.route('editTask', { id: task.id }) %>" class="btn btn-outline-primary btn-sm"><%= it.t('views.tasks.index.edit') %></a>
                    <form action="<%= it.route('deleteTask', { id: task.id }) %>" method="post" style="display: inline;" onsubmit="return confirm('<%= it.t('views.tasks.index.confirmDelete') %>');">
                      <input type="hidden" name="_method" value="DELETE">
                      <button type="submit" class="btn btn-outline-danger btn-sm"><%= it.t('views.tasks.index.delete') %></button>
                    </form>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<div class="mt-3">
  <% if (it.isAuthenticated()) { %>
    <a href="<%= it.route('newTask') %>" class="btn btn-primary"><%= it.t('views.tasks.index.newTask') %></a>
  <% } else { %>
    <p><%= it.t('views.tasks.index.loginRequired') %></p>
  <% } %>
</div>